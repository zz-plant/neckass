{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neckass",
  "main": "worker.js",
  // The date the Pages project has run on since its first deploy.
  "compatibility_date": "2024-09-29",
  "upload_source_maps": true,
  "workers_dev": true,
  "assets": {
    // The repository root is the site. .assetsignore keeps everything
    // else in the tree off it.
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // "404-page" would answer /card.png and /feed.xml with 404.html before
    // the Worker ran, since neither is a file. The Worker serves 404.html.
    "not_found_handling": "none",
    // The middleware rewrites the front page, so the Worker has to see it
    // before the asset is served.
    "run_worker_first": ["/", "/index.html"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
