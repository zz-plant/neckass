{
  "name": "neckass-headlines",
  "private": true,
  "type": "module",
  "scripts": {
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "serve": "bun run scripts/serve.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "assets:check": "bun run scripts/check-assets.ts",
    "cut:draw": "bun run scripts/draw-cut.ts",
    "og:generate": "bun run scripts/generate-og.ts",
    "edge": "wrangler dev --port 8800 --inspector-port 0 --log-level warn",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-wasm": "2.4.0",
    "satori": "0.15.2",
    "wrangler": "^4.150.0",
    "yoga-wasm-web": "0.3.3"
  }
}
